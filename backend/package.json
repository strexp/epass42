{
  "name": "@pkd42/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "tsc --noEmit false --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@pkd42/pki": "workspace:*",
    "@pkd42/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "ldapjs": "^3.0.7",
    "nodemailer": "^10.0.16",
    "openid-client": "^6.8.8",
    "pkijs": "^3.4.1",
    "smol-toml": "^1.9.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/ldapjs": "^3.0.6",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "openapi-types": "^12.1.3",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
