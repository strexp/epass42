# pkd42 backend environment (copy to .env and adjust).
# Every value overrides config.toml.

NODE_ENV=development
PKD42_HOST=127.0.0.1
PKD42_PORT=3000
PKD42_PUBLIC_URL=http://localhost:3000
# Browser-facing frontend origin (callback redirect + CORS).  Defaults to
# http://localhost:3001 in development; set empty for same-origin deployments.
PKD42_FRONTEND_URL=http://localhost:3001

# Any subset of pkd,csca,dsc.
PKD42_ROLES=pkd,csca,dsc

PKD42_COUNTRY_ALPHA2=XD
PKD42_COUNTRY_ALPHA3=UDN

PKD42_DB_PATH=./data/pkd42.db
PKD42_RUN_MIGRATIONS=true

# Change these for production.
PKD42_SESSION_SECRET=change-me-to-a-long-random-secret
PKD42_COOKIE_SECURE=false
PKD42_LOG_LEVEL=info

# Optional KEK for sealing private keys at rest.  If unset in development a
# random key is persisted at <dataDir>/kek so it survives restarts.
# PKD42_ENCRYPTION_KEK=<base64 32 bytes>

PKD42_TRUST_PROXY=false
PKD42_RATE_LIMIT_MAX=120
PKD42_RATE_LIMIT_WINDOW=60000

# PKD42_SMTP_URL=smtps://user:pass@smtp.example.net:465
PKD42_MAIL_FROM=pkd42 <no-reply@localhost>

PKD42_CSCA_ADMIN_MNTS=EXAMPLE-CSCA-MNT
PKD42_DSC_ADMIN_MNTS=EXAMPLE-DSC-MNT
PKD42_ADMIN_INCLUDE_MNT_BY=false

# JSON array matching the [[oauthProviders]] table in config.example.toml.
# PKD42_OAUTH_PROVIDERS=[]

# JSON array of { prefix, asn } used for the /dsc/jurisdiction lookup.
# PKD42_JURISDICTION_ROUTES=[{"prefix":"10.127.21.0/24","asn":4242422189}]
