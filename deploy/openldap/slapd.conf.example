# Example slapd.conf for the ePass 42 read-only PKD directory.
#
# 1. Import the LDIF produced by `GET /pkd/ldif`:
#      slapadd -f slapd.conf -l epass42.ldif
# 2. Start slapd and query it:
#      ldapsearch -x -H ldap://127.0.0.1:3890 \
#        -b "c=XD,dc=data,dc=download,dc=pkd,dc=icao,dc=int" \
#        "(objectClass=pkiCA)"

include  /etc/ldap/schema/core.schema
include  /etc/ldap/schema/cosine.schema
include  /etc/ldap/schema/inetorgperson.schema
include  /etc/ldap/schema/pki.schema
include  /etc/ldap/schema/epass42.schema

pidfile  /var/run/slapd/epass42.pid
argsfile /var/run/slapd/epass42.args

database mdb
suffix   "c=XD,dc=data,dc=download,dc=pkd,dc=icao,dc=int"
rootdn   "cn=admin,c=XD,dc=data,dc=download,dc=pkd,dc=icao,dc=int"
rootpw   change-me

# Read-only publishing: allow anonymous search from anywhere.
access to attrs=cACertificate,userCertificate,certificateRevocationList,cscaMasterListData
    by * read
access to *
    by * read

directory /var/lib/ldap/epass42
index objectClass eq
