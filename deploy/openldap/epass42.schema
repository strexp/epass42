# ePass 42 ICAO PKD LDAP schema additions.
#
# Include this file from slapd.conf after the standard schema:
#
#   include  /etc/ldap/schema/core.schema
#   include  /etc/ldap/schema/cosine.schema
#   include  /etc/ldap/schema/inetorgperson.schema
#   include  /etc/ldap/schema/pki.schema          # userCertificate / cRLDistributionPoint
#   include  /etc/ldap/schema/epass42.schema

# Standard certificate entries use pkiCA/cACertificate (CSCA),
# pkiUser/userCertificate (DSC) and cRLDistributionPoint (CRL) from pki.schema.
# This file only adds the ICAO CSCA Master List object class.

# CSCA Master List content (Doc 9303-12 §9).
attributetype (
  2.23.136.1.1.2
  NAME 'cscaMasterListData'
  DESC 'ICAO CSCA Master List (DER)'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.5 )

# Object class carrying a CSCA Master List; SUP person per the ICAO specification.
objectclass (
  2.23.136.2
  NAME 'cscaMasterList'
  SUP person
  MAY ( cscaMasterListData ) )
